# Copy this file to .env.local and add your TMDB credentials.
VITE_TMDB_API_KEY=your-tmdb-api-key
VITE_TMDB_READ_ACCESS_TOKEN=

# Public browser credentials from Supabase project settings. Never place the
# service-role or secret key in a VITE_ variable.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
